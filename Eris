<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eris 2.0</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #120b1c, #24113a, #100b18);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      width: 95%;
      max-width: 750px;
      height: 90vh;
      max-height: 800px;
      background: rgba(25, 18, 35, 0.95);
      border: 1px solid rgba(180, 120, 255, 0.25);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 0 40px rgba(120, 50, 200, 0.25);
      display: flex;
      flex-direction: column;
    }

    header {
      padding: 18px 22px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .logo {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #a855f7, #6d28d9);
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 24px;
      box-shadow: 0 0 20px rgba(168,85,247,0.5);
    }

    .info h1 {
      margin: 0;
      font-size: 22px;
    }

    .estado {
      margin-top: 4px;
      font-size: 13px;
      color: #b9a6c9;
    }

    #chat {
      flex: 1;
      overflow-y: auto;
      padding: 22px;
    }

    .mensaje {
      display: flex;
      margin-bottom: 18px;
    }

    .mensaje.usuario {
      justify-content: flex-end;
    }

    .burbuja {
      max-width: 80%;
      padding: 13px 16px;
      border-radius: 18px;
      line-height: 1.5;
      white-space: pre-wrap;
    }

    .eris .burbuja {
      background: #30213e;
      border-bottom-left-radius: 5px;
    }

    .usuario .burbuja {
      background: linear-gradient(135deg, #7c3aed, #9333ea);
      border-bottom-right-radius: 5px;
    }

    .hora {
      font-size: 10px;
      opacity: 0.55;
      margin-top: 5px;
    }

    .escribiendo {
      color: #b9a6c9;
      font-size: 13px;
