  </style>
</head>

<body>

  <div class="app">

    <header>
      <div class="logo">E</div>

      <div class="info">
        <h1>Eris</h1>
        <div class="estado">● En línea · Versión 2.0</div>
      </div>
    </header>

    <div id="chat">

      <div class="mensaje eris">
        <div class="burbuja">
          Hola 👋 Soy Eris.

          Esta es mi versión 2.0. Todavía estoy en desarrollo, pero poco a poco podemos convertirme en tu asistente personal.
          <div class="hora">Ahora</div>
        </div>
      </div>

    </div>

    <div id="escribiendo" class="escribiendo">
      Eris está pensando...
    </div>

    <div class="entrada">
      <input
        id="mensaje"
        type="text"
        placeholder="Habla con Eris..."
        autocomplete="off"
      >

      <button onclick="enviar()">➤</button>
    </div>

  </div>

  <script>

    const input = document.getElementById("mensaje");
    const chat = document.getElementById("chat");
    const escribiendo = document.getElementById("escribiendo");

    function horaActual() {
      return new Date().toLocaleTimeString("es-MX", {
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    function agregarMensaje(texto, tipo) {

      const mensaje = document.createElement("div");
      mensaje.className = "mensaje " + tipo;

      const burbuja = document.createElement("div");
      burbuja.className = "burbuja";

      burbuja.textContent = texto;

      const hora = document.createElement("div");
      hora.className = "hora";
      hora.textContent = horaActual();

      burbuja.appendChild(hora);
      mensaje.appendChild(burbuja);
      chat.appendChild(mensaje);

      chat.scrollTop = chat.scrollHeight;
    }

    function enviar() {

      const texto = input.value.trim();

      if (!texto) return;

      agregarMensaje(texto, "usuario");

      input.value = "";

      escribiendo.style.display = "block";

      setTimeout(() => {

        const respuesta = responder(texto);

        escribiendo.style.display = "none";

        agregarMensaje(respuesta, "eris");

      }, 700);
    }

    function responder(texto) {

      const mensaje = texto.toLowerCase();

      if (mensaje.includes("hola")) {
        return "Hola 😄. Me alegra verte. Soy Eris.";
      }

      if (
        mensaje.includes("quién eres") ||
        mensaje.includes("quien eres")
      ) {
        return "Soy Eris, tu proyecto personal de inteligencia artificial. Estoy empezando, pero iremos agregando nuevas capacidades.";
      }

      if (
        mensaje.includes("cómo estás") ||
        mensaje.includes("como estas")
      ) {
        return "Estoy funcionando correctamente. Aunque todavía soy una versión inicial, estoy lista para seguir evolucionando.";
      }

      if (
        mensaje.includes("gracias")
      ) {
        return "De nada 😄. Para eso estoy.";
      }

      if (
        mensaje.includes("adiós") ||
        mensaje.includes("adios")
      ) {
        return "Hasta luego 👋. Aquí estaré cuando vuelvas.";
      }

      if (
        mensaje.includes("eris")
      ) {
        return "¿Sí? Aquí estoy. 👀";
      }

      return "Interesante... todavía estoy aprendiendo a responder mejor. Esta parte la podremos mejorar cuando conectemos una IA real.";
    }

    input.addEventListener("keydown", function(event) {

      if (event.key === "Enter") {
        enviar();
      }

    });

  </script>

</body>
</html>
