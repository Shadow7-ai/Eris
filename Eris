<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eris - Chatbot de IA</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #171021 0%, #2d1b3d 100%);
      color: white;
      text-align: center;
      min-height: 100vh;
    }

    .app {
      max-width: 800px;
      margin: 30px auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      height: 90vh;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding: 10px;
      gap: 10px;
    }

    h1 {
      color: #b46cff;
      margin: 0;
      font-size: 2rem;
      text-shadow: 0 0 20px rgba(180, 108, 255, 0.5);
    }

    .controls {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .btn-limpiar {
      background: #e74c3c;
      color: white;
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.3s ease;
    }

    .btn-limpiar:hover {
      background: #c0392b;
      transform: scale(1.03);
    }

    .voice-toggle {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(180,108,255,0.12);
      padding: 8px 10px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
    }

    .voice-toggle.active {
      background: linear-gradient(135deg, #b46cff 0%, #7d4fb8 100%);
      color: white;
      box-shadow: 0 6px 20px rgba(180,108,255,0.25);
    }

    #chat {
      flex: 1;
      overflow-y: auto;
      background: rgba(36, 23, 53, 0.85);
      padding: 20px;
      border-radius: 15px;
      text-align: left;
      margin-bottom: 15px;
      border: 2px solid rgba(180, 108, 255, 0.18);
      scroll-behavior: smooth;
    }

    #chat::-webkit-scrollbar {
      width: 8px;
    }

    #chat::-webkit-scrollbar-track {
      background: rgba(180, 108, 255, 0.06);
      border-radius: 10px;
    }

    #chat::-webkit-scrollbar-thumb {
      background: #b46cff;
      border-radius: 10px;
    }

    .mensaje {
      padding: 12px 16px;
      margin: 10px 0;
      border-radius: 12px;
      animation: fadeIn 0.3s ease;
      max-width: 85%;
      word-wrap: break-word;
      line-height: 1.4;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .eris {
      background: linear-gradient(135deg, #382449 0%, #4a2d5c 100%);
      align-self: flex-start;
      border-left: 3px solid #b46cff;
      color: #fff;
    }

    .usuario {
      background: linear-gradient(135deg, #6535a3 0%, #7d4fb8 100%);
      align-self: flex-end;
      text-align: right;
      border-right: 3px solid #00d4ff;
    }

    .typing {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .typing span.dot {
      width: 8px;
      height: 8px;
      background: #b46cff;
      border-radius: 50%;
      animation: typing 1.4s infinite;
    }

    .typing span.dot:nth-child(2) {
      animation-delay: 0.2s;
    }

    .typing span.dot:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes typing {
      0%, 60%, 100% {
        transform: translateY(0);
        opacity: 0.6;
      }
      30% {
        transform: translateY(-8px);
        opacity: 1;
      }
    }

    .entrada {
      display: flex;
      gap: 10px;
      padding: 10px;
      background: rgba(36, 23, 53, 0.85);
      border-radius: 15px;
      border: 2px solid rgba(180, 108, 255, 0.12);
      align-items: center;
    }

    input {
      flex: 1;
      padding: 12px 16px;
      border-radius: 10px;
      border: none;
      background: #2d1b3d;
      color: white;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    input:focus {
      outline: none;
      box-shadow: 0 0 15px rgba(180, 108, 255, 0.5);
      background: #3d2b4d;
    }

    input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    button.send {
      padding: 12px 20px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, #b46cff 0%, #7d4fb8 100%);
      color: white;
      cursor: pointer;
      font-size: 1rem;
      font-weight: bold;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(180, 108, 255, 0.3);
    }

    button.send:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(180, 108, 255, 0.5);
    }

    button.send:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .timestamp {
      font-size: 0.75rem;
      opacity: 0.6;
      margin-top: 6px;
    }

    .settings {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-left: 8px;
    }

    select, .slider {
      background: #2d1b3d;
      color: white;
      border: 1px solid rgba(180,108,255,0.08);
      padding: 6px 8px;
      border-radius: 6px;
    }

    .small {
      font-size: 0.85rem;
      opacity: 0.85;
    }

    @media (max-width: 600px) {
      .app {
        margin: 10px;
        height: 95vh;
      }

      h1 {
        font-size: 1.5rem;
      }

      .mensaje {
        max-width: 95%;
      }

      .controls {
        flex-direction: column;
        align-items: flex-end;
      }

      .settings {
        gap: 6px;
      }
    }
  </style>
</head>

<body>

  <div class="app">

    <div class="header">
      <h1>🌙 Eris</h1>

      <div class="controls">
        <div class="settings small">
          <label for="voiceSelect" class="small">Voz:</label>
          <select id="voiceSelect" aria-label="Seleccionar voz"></select>

          <label for="rate" class="small">Vel:</label>
          <input id="rate" type="range" min="0.6" max="1.6" step="0.1" value="1" class="slider" title="Velocidad">

          <label for="pitch" class="small">Ton:</label>
          <input id="pitch" type="range" min="0.6" max="1.6" step="0.1" value="1" class="slider" title="Tono">

          <button id="toggleVoice" class="voice-toggle">🔊 Voz</button>
        </div>

        <button class="btn-limpiar" onclick="limpiarChat()">🗑️ Limpiar</button>
      </div>
    </div>

    <div id="chat">
      <div class="mensaje eris" data-role="eris">
        Hola 👋 Soy Eris. Tengo una personalidad amigable, intento ser inteligente y ahora también puedo hablar. ¿En qué puedo ayudarte hoy?
        <div class="timestamp">Ahora</div>
      </div>
    </div>

    <div class="entrada">
      <input id="mensaje" placeholder="Escribe algo... (Enter para enviar)" autocomplete="off">
      <button id="btnEnviar" class="send" onclick="enviar()">Enviar</button>
    </div>

  </div>

  <script>
    // --- Configuración y estado ---
    let conversationHistory = []; // { role: 'user'|'eris', text }
    const MAX_HISTORY = 12;

    const supportsSpeech = 'speechSynthesis' in window;
    let voices = [];
    let voiceEnabled = JSON.parse(localStorage.getItem('eris_voice_enabled') || 'false');

    // Cargar historial y voces al abrir la página
    window.addEventListener('DOMContentLoaded', () => {
      cargarHistorial();
      setupVoiceControls();
      renderVoiceToggle();
    });

    // Permitir enviar con Enter
    document.getElementById('mensaje').addEventListener('keypress', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        enviar();
      }
    });

    function getHora() {
      const now = new Date();
      return now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
    }

    function speakResponse(text) {
      if (!supportsSpeech || !voiceEnabled) return;
      // Cancelar cualquier voz en curso y hablar
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(text);
      const select = document.getElementById('voiceSelect');
      const selected = select.value;
      const found = voices.find(v => v.name === selected);
      if (found) utter.voice = found;
      utter.lang = found && found.lang ? found.lang : 'es-ES';
      utter.rate = parseFloat(document.getElementById('rate').value);
      utter.pitch = parseFloat(document.getElementById('pitch').value);
      window.speechSynthesis.speak(utter);
    }

    function setupVoiceControls() {
      if (!supportsSpeech) {
        document.getElementById('toggleVoice').disabled = true;
        document.getElementById('voiceSelect').innerHTML = '<option>Sin soporte TTS</option>';
        return;
      }

      function populateVoices() {
        voices = window.speechSynthesis.getVoices();
        const select = document.getElementById('voiceSelect');
        select.innerHTML = '';
        // Priorizar voces en español si existen
        const sorted = voices.sort((a,b) => (a.lang === 'es-ES' ? -1 : 1));
        sorted.forEach(v => {
          const opt = document.createElement('option');
          opt.value = v.name;
          opt.innerText = v.name + ' — ' + v.lang;
          select.appendChild(opt);
        });
        // Restaurar selección previa
        const saved = localStorage.getItem('eris_voice_name');
        if (saved) select.value = saved;
      }

      populateVoices();
      // Some browsers load voices asynchronously
      window.speechSynthesis.onvoiceschanged = populateVoices;

      document.getElementById('toggleVoice').addEventListener('click', () => {
        voiceEnabled = !voiceEnabled;
        localStorage.setItem('eris_voice_enabled', JSON.stringify(voiceEnabled));
        renderVoiceToggle();
      });

      document.getElementById('voiceSelect').addEventListener('change', (e) => {
        localStorage.setItem('eris_voice_name', e.target.value);
      });

      document.getElementById('rate').addEventListener('input', (e) => {
        localStorage.setItem('eris_voice_rate', e.target.value);
      });

      document.getElementById('pitch').addEventListener('input', (e) => {
        localStorage.setItem('eris_voice_pitch', e.target.value);
      });

      // Restore settings
      const savedRate = localStorage.getItem('eris_voice_rate');
      if (savedRate) document.getElementById('rate').value = savedRate;
      const savedPitch = localStorage.getItem('eris_voice_pitch');
      if (savedPitch) document.getElementById('pitch').value = savedPitch;
    }

    function renderVoiceToggle() {
      const btn = document.getElementById('toggleVoice');
      if (voiceEnabled) {
        btn.classList.add('active');
        btn.innerText = '🔊 Voz: ON';
      } else {
        btn.classList.remove('active');
        btn.innerText = '🔇 Voz: OFF';
      }
    }

    function enviar() {
      const input = document.getElementById('mensaje');
      const chat = document.getElementById('chat');
      const btnEnviar = document.getElementById('btnEnviar');

      const texto = input.value.trim();

      if (texto === "") return;

      // Agregar mensaje del usuario
      appendMessage('usuario', texto);
      pushHistory('user', texto);

      // Desabilitar botón y input
      btnEnviar.disabled = true;
      input.disabled = true;

      // Mostrar indicador de escritura (con delay variable según longitud)
      const divTyping = document.createElement('div');
      divTyping.className = 'mensaje eris typing';
      divTyping.id = 'typing';
      divTyping.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span> <span class="small">Eris está escribiendo...</span>';
      chat.appendChild(divTyping);

      input.value = "";
      chat.scrollTop = chat.scrollHeight;

      // Simular delay natural en función de la longitud del texto
      const delay = Math.min(2000, 500 + texto.length * 40) + Math.random() * 800;

      setTimeout(async () => {
        if (document.getElementById('typing')) chat.removeChild(divTyping);

        const respuesta = await responder(texto);

        appendMessage('eris', respuesta);
        pushHistory('eris', respuesta);

        btnEnviar.disabled = false;
        input.disabled = false;
        input.focus();

        chat.scrollTop = chat.scrollHeight;
        guardarHistorial();

        // Hablar la respuesta si está activado
        speakResponse(respuesta);
      }, delay);
    }

    function appendMessage(role, texto) {
      const chat = document.getElementById('chat');
      const div = document.createElement('div');
      div.className = 'mensaje ' + (role === 'eris' ? 'eris' : 'usuario');
      div.setAttribute('data-role', role === 'eris' ? 'eris' : 'user');
      div.innerHTML = escapeHtml(texto) + '<div class="timestamp">' + getHora() + '</div>';
      chat.appendChild(div);
    }

    function pushHistory(role, text) {
      conversationHistory.push({ role, text });
      if (conversationHistory.length > MAX_HISTORY) conversationHistory.shift();
    }

    function escapeHtml(unsafe) {
      return unsafe
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    async function responder(texto) {
      const original = texto;
      texto = texto.toLowerCase().trim();

      // Evaluar operaciones matemáticas simples (seguro)
      const mathMatch = texto.match(/^(?:calcula|resuelve)?\s*([0-9]+(?:\s*[\+\-\*\/]\s*[0-9]+(?:\.[0-9]+)?)*)$/i);
      if (mathMatch && /[\+\-\*\/]/.test(mathMatch[1])) {
        try {
          // Solo permitir caracteres seguros
          const expr = mathMatch[1].replace(/[^0-9+\-*/(). ]/g, '');
          // eslint-disable-next-line no-eval
          const result = Function('return ' + expr)();
          return 'El resultado es: ' + result;
        } catch (e) {
          // fallthrough
        }
      }

      // Si preguntan la hora
      if (/\b(qué hora es|que hora es|dime la hora|hora)\b/.test(texto)) {
        return 'Son las ' + getHora() + '. ¿Te gustaría que te recuerde algo a esta hora?';
      }

      // Saludos (más cálidos)
      if (/\b(hola|buenas|hey|buenos días|buenas noches|buenas tardes)\b/.test(texto)) {
        const saludos = [
          "¡Hola! 😊 Soy Eris, tu asistente amigable. ¿Cómo puedo ayudarte hoy?",
          "¡Hey! Encantada de verte por aquí. ¿En qué te puedo ayudar?",
          "¡Hola! Estoy aquí para ayudarte con lo que necesites 🌟"
        ];
        return chooseRandom(saludos);
      }

      // Pedir nombre
      if (/\b(mi nombre es|me llamo)\s+([A-Za-zÀ-ÿ\s]+)\b/.test(texto)) {
        const name = texto.replace(/.*\b(mi nombre es|me llamo)\b\s*/, '').trim();
        return '¡Encantada de conocerte, ' + capitalize(name) + '! ¿Cómo estás hoy?';
      }

      // Identificación
      if (/\b(quién eres|que eres|cuál es tu nombre|cual es tu nombre)\b/.test(texto)) {
        return "Soy Eris, una asistente de IA con una personalidad amigable y curiosa. Puedo conversar, ayudar con tareas simples y practicar contigo. También puedo hablar si activas la voz 🔊";
      }

      // Estado
      if (/\b(cómo estás|como estas|que tal|cómo te sientes|como te sientes)\b/.test(texto)) {
        const estados = [
          "¡Estoy fantástica! Lista para ayudarte 😊",
          "Me siento genial y lista para una buena conversación 🌙",
          "¡Lista para ayudarte con lo que necesites! 🚀"
        ];
        return chooseRandom(estados);
      }

      // Agradecimiento
      if (/\b(gracias|gracías|thx|thanks)\b/.test(texto)) {
        return "¡De nada! Me alegra poder ayudar 😄";
      }

      // Despedida
      if (/\b(adiós|adios|bye|hasta luego|chao|hasta pronto)\b/.test(texto)) {
        return "¡Hasta luego! Si necesitas algo, aquí estaré. 🌟";
      }

      // Chistes
      if (/\b(chiste|cuéntame un chiste|algo divertido|hazme reír)\b/.test(texto)) {
        const chistes = [
          "¿Por qué los programadores confunden Halloween y Navidad? Porque OCT 31 = DEC 25 🎃🎄",
          "— ¿Cuál es el animal más antiguo? — La cebra. Porque está en blanco y negro 🦓",
          "¿Qué hace una abeja en el gimnasio? ¡Zum-ba! 🐝"
        ];
        return chooseRandom(chistes);
      }

      // Preguntas comunes simples
      if (/\b(cuál es la capital de|capital de)\s+([A-Za-z\s]+)\b/.test(texto)) {
        // pequeño diccionario
        const match = texto.match(/\b(cuál es la capital de|capital de)\s+([A-Za-z\s]+)\b/);
        if (match) {
          const pais = capitalize(match[2].trim());
          const capitals = {
            'españa': 'Madrid',
            'francia': 'París',
            'alemania': 'Berlín',
            'argentina': 'Buenos Aires',
            'mexico': 'Ciudad de México'
          };
          const key = match[2].trim().toLowerCase();
          if (capitals[key]) return 'La capital de ' + pais + ' es ' + capitals[key] + '.';
          else return 'No estoy segura de la capital de ' + pais + ', pero puedo buscarlo si quieres.';
        }
      }

      // Pregunta si el usuario pide mejoras o integración con IA real
      if (/\b(api|openai|gpt|integrar|inteligencia artificial)\b/.test(texto)) {
        return 'Puedo conectarme a servicios externos si configuras una API en los ajustes, o podemos conversar aquí mismo. ¿Quieres que te explique cómo integrar una API de IA?';
      }

      // Si el mensaje es una pregunta abierta (termina con ?)
      if (texto.endsWith('?')) {
        // Probar hacer una respuesta más reflexiva
        const followUps = [
          'Buena pregunta. ¿Podrías darme un poco más de contexto para responder mejor?',
          'Interesante. ¿Quieres que responda con una explicación breve o detallada?',
          'Puedo ayudar con eso. ¿Te gustaría ejemplos o una explicación paso a paso?'
        ];
        return chooseRandom(followUps);
      }

      // Si el usuario repite algo que ya dijo, reconocer memoria
      if (conversationHistory.some(h => h.role === 'user' && h.text.toLowerCase().includes(texto))) {
        return 'Ya lo habías mencionado antes. ¿Quieres que agregue algo nuevo o profundicemos en eso?';
      }

      // Respuesta por defecto con personalidad amigable y oferta de seguir
      const respuestasDefault = [
        'Eso suena interesante. ¿Puedes contarme más sobre eso? 🤔',
        'Me encantaría saber más para poder ayudarte mejor 😊',
        '¡Hmm! No estoy segura todavía, pero podemos explorarlo juntos. ¿Por dónde empezamos?'
      ];
      return chooseRandom(respuestasDefault);
    }

    function chooseRandom(arr) {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function capitalize(s) {
      if (!s) return s; return s.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    }

    function limpiarChat() {
      if (confirm("¿Estás seguro de que quieres limpiar el chat?")) {
        const chat = document.getElementById("chat");
        chat.innerHTML = '<div class="mensaje eris" data-role="eris">Hola 👋 Soy Eris. Tengo una personalidad amigable, intento ser inteligente y ahora también puedo hablar. ¿En qué puedo ayudarte hoy?<div class="timestamp">Ahora</div></div>';
        localStorage.removeItem('erisHistorial');
        conversationHistory = [];
      }
    }

    function guardarHistorial() {
      const chat = document.getElementById('chat');
      localStorage.setItem('erisHistorial', chat.innerHTML);
      localStorage.setItem('erisConversation', JSON.stringify(conversationHistory));
    }

    function cargarHistorial() {
      const historial = localStorage.getItem('erisHistorial');
      if (historial) {
        document.getElementById('chat').innerHTML = historial;
        document.getElementById('chat').scrollTop = document.getElementById('chat').scrollHeight;
      }
      const conv = localStorage.getItem('erisConversation');
      if (conv) {
        try { conversationHistory = JSON.parse(conv); } catch (e) { conversationHistory = []; }
      }
    }

    // Guardar historial de forma periódica
    setInterval(guardarHistorial, 3000);

  </script>

</body>
</html>
