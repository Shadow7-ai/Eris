<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Eris - Chatbot de IA</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:'Segoe UI',Tahoma, Geneva, Verdana, sans-serif;background:linear-gradient(135deg,#0f0712 0%,#2a1533 100%);color:#fff;min-height:100vh}
    .app{max-width:900px;margin:24px auto;padding:18px;display:flex;flex-direction:column;height:92vh}
    .header{display:flex;justify-content:space-between;align-items:center;gap:12px}
    h1{color:#c28cff;margin:0;font-size:1.6rem;text-shadow:0 0 18px rgba(194,140,255,.25)}
    .controls{display:flex;gap:10px;align-items:center}
    .btn{background:#b46cff;border:none;color:white;padding:8px 12px;border-radius:8px;cursor:pointer}
    .btn.ghost{background:transparent;border:1px solid rgba(180,108,255,.12)}
    #chat{flex:1;overflow:auto;background:rgba(20,12,28,.7);padding:18px;border-radius:14px;margin:14px 0;border:1px solid rgba(180,108,255,.12)}
    .mensaje{padding:12px 14px;margin:10px 0;border-radius:12px;max-width:86%;line-height:1.4}
    .eris{background:linear-gradient(135deg,#392344 0%,#4c2b5e 100%);align-self:flex-start;border-left:3px solid #d8b0ff}
    .usuario{background:linear-gradient(135deg,#5b2da0 0%,#7c4fb8 100%);align-self:flex-end;text-align:right;border-right:3px solid #59e6ff}
    .timestamp{font-size:.75rem;opacity:.6;margin-top:6px}
    .entrada{display:flex;gap:10px;padding:8px;border-radius:12px;background:rgba(20,12,28,.6);align-items:center}
    input#mensaje{flex:1;padding:12px 14px;border-radius:8px;border:1px solid rgba(180,108,255,.06);background:#2d1b3d;color:#fff}
    .settings{display:flex;gap:8px;align-items:center}
    select,.slider{background:#2d1b3d;color:#fff;border-radius:6px;padding:6px;border:1px solid rgba(180,108,255,.06)}
    .small{font-size:.85rem;opacity:.9}
    .status{font-size:.85rem;opacity:.8}
    .chip{padding:6px 8px;border-radius:999px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.04)}
    @media(max-width:640px){.app{margin:8px;height:95vh}.controls{flex-direction:column;align-items:flex-end}.header h1{font-size:1.2rem}}
  </style>
</head>
<body>
  <div class="app" role="application" aria-label="Chat Eris">
    <div class="header">
      <h1>🌙 Eris — Asistente Amigable</h1>
      <div class="controls">
        <div class="settings small">
          <label for="voiceSelect" class="small">Voz</label>
          <select id="voiceSelect" aria-label="Seleccionar voz"></select>
          <label for="rate" class="small">Vel</label>
          <input id="rate" class="slider" type="range" min="0.6" max="1.6" step="0.1" value="1" title="Velocidad" />
          <label for="pitch" class="small">Ton</label>
          <input id="pitch" class="slider" type="range" min="0.6" max="1.6" step="0.1" value="1" title="Tono" />
          <button id="toggleVoice" class="btn ghost" aria-pressed="false">🔇 Voz</button>
        </div>
        <div style="display:flex;gap:8px;align-items:center;margin-left:8px">
          <button id="toggleListen" class="btn ghost">🎙️ Escuchar</button>
          <button id="btnClear" class="btn ghost">🗑️ Limpiar</button>
          <button id="btnExport" class="btn">⬇️ Export</button>
          <button id="btnImport" class="btn ghost">⬆️ Import</button>
        </div>
      </div>
    </div>

    <div id="chat" aria-live="polite">
      <div class="mensaje eris" data-role="eris">Hola 👋 Soy Eris. Soy amigable, curiosa e inteligente. Puedo hablar y escucharte. ¿En qué puedo ayudarte hoy?<div class="timestamp">Ahora</div></div>
    </div>

    <div class="entrada">
      <input id="mensaje" placeholder="Escribe algo... (Enter para enviar)" autocomplete="off" aria-label="Mensaje" />
      <button id="btnEnviar" class="btn">Enviar</button>
    </div>

  </div>

  <input type="file" id="importFile" accept="application/json" style="display:none" />

  <script>
    // State
    const MAX_HISTORY = 30;
    let conversationHistory = []; // {role:'user'|'eris', text}

    // TTS
    const supportsTTS = 'speechSynthesis' in window;
    let voices = [];
    let voiceEnabled = JSON.parse(localStorage.getItem('eris_voice_enabled') || 'false');

    // STT
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition || null;
    let recognition = null;
    let listening = false;

    // API integration scaffold (local mode by default)
    let useExternalAI = false; // toggle to use external API
    // NOTE: To integrate an API (OpenAI, etc.) add a safe server-side proxy; do NOT store secrets in client-side code.

    // UI refs
    const chatEl = document.getElementById('chat');
    const inputEl = document.getElementById('mensaje');
    const btnEnviar = document.getElementById('btnEnviar');
    const btnClear = document.getElementById('btnClear');
    const btnExport = document.getElementById('btnExport');
    const btnImport = document.getElementById('btnImport');
    const importFile = document.getElementById('importFile');
    const toggleVoice = document.getElementById('toggleVoice');
    const toggleListen = document.getElementById('toggleListen');

    // Initialization
    window.addEventListener('DOMContentLoaded', () => {
      loadFromStorage();
      setupTTS();
      renderVoiceToggle();
      setupEvents();
      setupSTT();
    });

    function setupEvents(){
      inputEl.addEventListener('keypress', (e)=>{ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendMessage(); } });
      btnEnviar.addEventListener('click', sendMessage);
      btnClear.addEventListener('click', clearChat);
      btnExport.addEventListener('click', exportChat);
      btnImport.addEventListener('click', ()=>importFile.click());
      importFile.addEventListener('change', handleImportFile);
      toggleVoice.addEventListener('click', ()=>{ voiceEnabled = !voiceEnabled; localStorage.setItem('eris_voice_enabled', JSON.stringify(voiceEnabled)); renderVoiceToggle(); });
      toggleListen.addEventListener('click', toggleListening);
      window.addEventListener('beforeunload', ()=>{ saveToStorage(); });
    }

    // --- Storage ---
    function saveToStorage(){
      localStorage.setItem('erisChatHTML', chatEl.innerHTML);
      localStorage.setItem('erisConversation', JSON.stringify(conversationHistory));
    }

    function loadFromStorage(){
      const html = localStorage.getItem('erisChatHTML');
      if(html){ chatEl.innerHTML = html; chatEl.scrollTop = chatEl.scrollHeight; }
      const conv = localStorage.getItem('erisConversation');
      if(conv){ try{ conversationHistory = JSON.parse(conv); }catch(e){ conversationHistory = []; } }
    }

    function exportChat(){
      const data = { conversationHistory, exportedAt: new Date().toISOString() };
      const blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'eris-conversation.json'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(url),1000);
    }

    function handleImportFile(e){
      const f = e.target.files[0]; if(!f) return; const reader = new FileReader();
      reader.onload = ()=>{ try{ const data = JSON.parse(reader.result); if(data.conversationHistory){ conversationHistory = data.conversationHistory.slice(-MAX_HISTORY); rebuildChatFromHistory(); saveToStorage(); alert('Importado con éxito.'); }else alert('Archivo inválido'); }catch(err){ alert('Error al parsear JSON'); } };
      reader.readAsText(f);
    }

    function rebuildChatFromHistory(){ chatEl.innerHTML = ''; conversationHistory.forEach(m=> appendMessage(m.role, m.text, false)); chatEl.scrollTop = chatEl.scrollHeight; }

    // --- Messages ---
    function appendMessage(role, text, save=true){ const d = document.createElement('div'); d.className='mensaje '+(role==='eris'?'eris':'usuario'); d.setAttribute('data-role', role); d.innerHTML = escapeHtml(text) + '<div class="timestamp">'+getTime()+'</div>'; chatEl.appendChild(d); if(save){ conversationHistory.push({role,text}); if(conversationHistory.length>MAX_HISTORY) conversationHistory.shift(); saveToStorage(); } chatEl.scrollTop = chatEl.scrollHeight; }

    function escapeHtml(s){ return s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'","&#039;"); }

    function getTime(){ return new Date().toLocaleTimeString('es-ES',{hour:'2-digit',minute:'2-digit'}); }

    // --- Core responder (local mode, extendable) ---
    async function responder(input){
      const t = input.toLowerCase().trim();

      // small NLP-ish heuristics
      // 1) Math
      const math = t.match(/(?:^|\s)(?:calcula|resuelve|cuánto es|cuanto es)?\s*([0-9+\-*/().\s]+)\s*$/i);
      if(math && /[+\-*/]/.test(math[1])){
        try{ const safe = math[1].replace(/[^0-9+\-*/(). ]/g,''); const res = Function('return '+safe)(); return 'El resultado es: '+res; }catch(e){}
      }

      // 2) Time
      if(/\b(qué hora es|que hora es|dime la hora|hora)\b/.test(t)) return 'Son las '+getTime()+'. ¿Quieres que programe un recordatorio?';

      // 3) Greetings
      if(/\b(hola|buenas|hey|buenos días|buenas tardes|buenas noches)\b/.test(t)){
        const opts=['¡Hola! 😊 Soy Eris, tu asistente. ¿Cómo estás?','¡Hey! Encantada de verte. ¿En qué puedo ayudarte?','¡Hola! Aquí para ayudarte con lo que necesites 🌙']; return pick(opts);
      }

      // 4) Name capture
      if(/\b(me llamo|mi nombre es)\s+([a-záéíóúñü\s]+)\b/i.test(input)){
        const name = input.replace(/.*\b(me llamo|mi nombre es)\b\s*/i,'').trim(); return '¡Encantada de conocerte, '+toTitle(name)+ '! ¿Cómo estás?';
      }

      // 5) Capital simple lookup
      const capMatch = t.match(/\b(?:capital de|cuál es la capital de|capital)\s+([a-z\s]+)\b/);
      if(capMatch){ const pais=capMatch[1].trim().toLowerCase(); const capitals={'españa':'Madrid','francia':'París','alemania':'Berlín','argentina':'Buenos Aires','méxico':'Ciudad de México','mexico':'Ciudad de México'}; if(capitals[pais]) return 'La capital de '+toTitle(pais)+' es '+capitals[pais]+'.'; else return 'No la sé con certeza, pero puedo buscarla si quieres.' }

      // 6) Jokes
      if(/\b(chiste|hazme reír|cuéntame un chiste)\b/.test(t)){
        const jokes=['¿Por qué los programadores confunden Halloween y Navidad? Porque OCT 31 = DEC 25 🎃🎄','— ¿Cuál es el animal más antiguo? — La cebra. Porque está en blanco y negro 🦓','¿Qué hace una abeja en el gimnasio? ¡Zum-ba! 🐝']; return pick(jokes);
      }

      // 7) Help / capabilities
      if(/\b(qué puedes hacer|que puedes hacer|ayuda|help)\b/.test(t)){
        return 'Puedo conversar, responder preguntas simples, hacer cálculos básicos, escuchar y hablar. Si integras una API externa puedo responder con más detalle y ejecutar tareas avanzadas.';
      }

      // 8) If a question
      if(input.trim().endsWith('?')) return pick(['Buena pregunta — ¿puedes darme un poco más de contexto?','Interesante, ¿quieres una respuesta corta o detallada?','Puedo ayudarte con eso. ¿Te gustaría ejemplos?']);

      // 9) Memory check
      if(conversationHistory.some(h=>h.role==='user' && h.text.toLowerCase().includes(t))) return 'Creo que ya me lo dijiste antes. ¿Quieres que profundicemos?';

      // 10) Default friendly follow-up
      return pick(['Suena interesante. ¿Puedes contarme más? 🤔','Me encantaría ayudarte con eso 😊','¡Podemos explorarlo juntos! ¿Por dónde empezamos?']);
    }

    // --- Message sending flow ---
    async function sendMessage(){
      const text = inputEl.value.trim(); if(!text) return; inputEl.value=''; appendMessage('user',text); showTyping();
      try{
        // If external AI mode is enabled, call external API (scaffold)
        let reply='';
        if(useExternalAI){
          reply = await callExternalAI(text, conversationHistory);
        } else {
          reply = await responder(text);
        }
        hideTyping(); appendMessage('eris',reply);
        if(voiceEnabled) speak(reply);
      }catch(err){ hideTyping(); appendMessage('eris','Lo siento, ha ocurrido un error al generar la respuesta.'); console.error(err); }
    }

    function showTyping(){ const d=document.createElement('div'); d.className='mensaje eris typing'; d.id='_typing_'; d.innerHTML='<span class="chip">Eris está escribiendo…</span>'; chatEl.appendChild(d); chatEl.scrollTop=chatEl.scrollHeight; }
    function hideTyping(){ const t=document.getElementById('_typing_'); if(t) t.remove(); }

    // --- TTS helpers ---
    function setupTTS(){ if(!supportsTTS){ document.getElementById('toggleVoice').disabled=true; document.getElementById('voiceSelect').innerHTML='<option>No soportado</option>'; return; }
      function populate(){ voices = window.speechSynthesis.getVoices() || []; const sel=document.getElementById('voiceSelect'); sel.innerHTML=''; const sorted = voices.slice().sort((a,b)=> (a.lang==='es-ES'? -1:1)); sorted.forEach(v=>{ const o=document.createElement('option'); o.value=v.name; o.textContent=v.name+' — '+v.lang; sel.appendChild(o); }); const saved = localStorage.getItem('eris_voice_name'); if(saved) sel.value=saved; }
      populate(); window.speechSynthesis.onvoiceschanged = populate;
      document.getElementById('voiceSelect').addEventListener('change',(e)=> localStorage.setItem('eris_voice_name', e.target.value));
      const savedRate = localStorage.getItem('eris_voice_rate'); if(savedRate) document.getElementById('rate').value=savedRate;
      const savedPitch = localStorage.getItem('eris_voice_pitch'); if(savedPitch) document.getElementById('pitch').value=savedPitch;
      document.getElementById('rate').addEventListener('input', e=> localStorage.setItem('eris_voice_rate', e.target.value));
      document.getElementById('pitch').addEventListener('input', e=> localStorage.setItem('eris_voice_pitch', e.target.value));
    }

    function renderVoiceToggle(){ toggleVoice.classList.toggle('active', voiceEnabled); toggleVoice.textContent = voiceEnabled? '🔊 Voz: ON' : '🔇 Voz: OFF'; toggleVoice.setAttribute('aria-pressed', voiceEnabled); }

    function speak(text){ if(!supportsTTS || !voiceEnabled) return; window.speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance(text); const sel = document.getElementById('voiceSelect'); const vname = sel.value; const v = voices.find(x=>x.name===vname); if(v) u.voice = v; u.lang = (v && v.lang)? v.lang : 'es-ES'; u.rate = parseFloat(document.getElementById('rate').value); u.pitch = parseFloat(document.getElementById('pitch').value); window.speechSynthesis.speak(u); }

    // --- STT helpers ---
    function setupSTT(){ if(!SpeechRecognition){ toggleListen.disabled=true; toggleListen.title='SpeechRecognition no disponible en este navegador'; return; } recognition = new SpeechRecognition(); recognition.lang='es-ES'; recognition.interimResults=false; recognition.maxAlternatives=1; recognition.onresult = (e)=>{ const text = e.results[0][0].transcript; inputEl.value = text; sendMessage(); }; recognition.onend = ()=>{ listening=false; updateListenUI(); }; recognition.onerror = (e)=>{ console.error('STT error',e); listening=false; updateListenUI(); } }

    function toggleListening(){ if(!recognition) return; if(listening){ recognition.stop(); listening=false; } else { recognition.start(); listening=true; } updateListenUI(); }
    function updateListenUI(){ toggleListen.textContent = listening? '⏹️ Parar' : '🎙️ Escuchar'; toggleListen.classList.toggle('active', listening); }

    // --- External AI scaffold ---
    async function callExternalAI(userText, history){
      // Scaffold: Implement server-side proxy to call real AI (OpenAI, etc.)
      // Example POST body: {messages: history.concat({role:'user', content:userText}), max_tokens:500}
      // For now fallback to local responder
      return await responder(userText);
    }

    // --- Utilities ---
    function pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }
    function toTitle(s){ return s.split(' ').filter(Boolean).map(w=>w.charAt(0).toUpperCase()+w.slice(1)).join(' '); }

    function clearChat(){ if(confirm('¿Seguro que quieres borrar el chat?')){ chatEl.innerHTML = '<div class="mensaje eris" data-role="eris">Hola 👋 Soy Eris. Soy amigable, curiosa e inteligente. Puedo hablar y escucharte. ¿En qué puedo ayudarte hoy?<div class="timestamp">Ahora</div></div>'; conversationHistory=[]; saveToStorage(); } }

    // For accessibility: focus input after sending
    document.addEventListener('click', ()=> inputEl.focus());
  </script>
</body>
</html>
