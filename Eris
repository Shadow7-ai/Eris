<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eris</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #171021;
      color: white;
      text-align: center;
    }

    .app {
      max-width: 600px;
      margin: 50px auto;
      padding: 20px;
    }

    h1 {
      color: #b46cff;
    }

    #chat {
      height: 400px;
      overflow-y: auto;
      background: #241735;
      padding: 15px;
      border-radius: 15px;
      text-align: left;
    }

    .mensaje {
      padding: 10px;
      margin: 10px 0;
      border-radius: 10px;
    }

    .eris {
      background: #382449;
    }

    .usuario {
      background: #6535a3;
      text-align: right;
    }

    .entrada {
      display: flex;
      margin-top: 15px;
      gap: 10px;
    }

    input {
      flex: 1;
      padding: 12px;
      border-radius: 10px;
      border: none;
    }

    button {
      padding: 12px;
      border: none;
      border-radius: 10px;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <div class="app">

    <h1>🌙 Eris</h1>

    <div id="chat">
      <div class="mensaje eris">
        Hola 👋 Soy Eris. Estoy lista para comenzar.
      </div>
    </div>

    <div class="entrada">
      <input id="mensaje" placeholder="Escribe algo...">
      <button onclick="enviar()">Enviar</button>
    </div>

  </div>

  <script>
    function enviar() {
      const input = document.getElementById("mensaje");
      const chat = document.getElementById("chat");

      const texto = input.value.trim();

      if (texto === "") return;

      chat.innerHTML +=
        '<div class="mensaje usuario">' + texto + '</div>';

      let respuesta = responder(texto);

      chat.innerHTML +=
        '<div class="mensaje eris">' + respuesta + '</div>';

      input.value = "";
      chat.scrollTop = chat.scrollHeight;
    }

    function responder(texto) {
      texto = texto.toLowerCase();

      if (texto.includes("hola")) {
        return "Hola 😄. Soy Eris.";
      }

      if (texto.includes("quien eres")) {
        return "Soy Eris, tu proyecto personal de IA.";
      }

      if (texto.includes("cómo estás") || texto.includes("como estas")) {
        return "Estoy funcionando correctamente.";
      }

      if (texto.includes("gracias")) {
        return "De nada 😄.";
      }

      return "Todavía estoy aprendiendo. Podemos mejorarme poco a poco.";
    }
  </script>

</body>
</html>
